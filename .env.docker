# -----------------------------------------------------------------------
# AnkiCollab local dev environment — dummy credentials, works out of the
# box. Copy to `.env.docker` (already named that) and just run:
#   docker compose up --build
#
# Values here are consumed two ways:
#  - top-level ones (POSTGRES_*, RUSTFS_*, S3_BUCKET_NAME) are referenced
#    directly inside docker-compose.yml via ${VAR} interpolation
#  - the whole file is also loaded into the backend & website containers
#    via `env_file:`, so anything the Rust apps read with std::env / dotenvy
#    just needs to be listed below
# -----------------------------------------------------------------------

### Postgres ###
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ankicollab

### rustFS (S3-compatible local object storage) ###
RUSTFS_ACCESS_KEY=ANKICOLLABDEV
RUSTFS_SECRET_KEY=some-long-random-development-secret
S3_BUCKET_NAME=media

# -----------------------------------------------------------------------
# Everything below mirrors backend/.env.example and website/.env.example.
# docker-compose.yml already overrides DATABASE_URL, S3_DOMAIN,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET_NAME/S3_MEDIA_BUCKET
# per-service with the values above, so you don't need to touch those
# here — they're just listed for reference.
# -----------------------------------------------------------------------

### Shared secrets (dummy values, fine for local dev only) ###
MEDIA_TOKEN_SECRET=dev-media-token-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
STATS_CACHE_KEY=dev-stats-cache-key
CACHE_TOKEN_SECRET=dev-cache-token-secret-32-bytes!!
OFF_SITE_SECRET_SALT=dev-off-site-secret-salt

### Backend-specific (AnkiCollab-Backend/.env.example) ###
SENTRY_URL=
MAX_STORAGE_BYTES=1000000000
STRICT_API_RATE_LIMIT_PER_MINUTE=60
STANDARD_API_RATE_LIMIT_PER_MINUTE=600
MEDIA_API_RATE_LIMIT_PER_MINUTE=600
# Served through the nginx `media.localhost` vhost — add
# `127.0.0.1 media.localhost plugin.localhost` to your hosts file.
MEDIA_BASE_URL=http://media.localhost
MEDIA_DOWNLOAD_TOKEN_TTL_SECS=900
MEDIA_UPLOAD_TOKEN_TTL_SECS=900
DECK_CACHE_PRESIGNED_TTL_SECS=1800
S3_MAX_RPS=100
S3_MAX_CONCURRENCY=48
WEBSITE_BASE_URL=http://localhost

### Website-specific (AnkiCollab-Website/.env.example) ###
COOKIE_SECURE=true
MEDIA_PROXY_URL=http://media.localhost
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/dummy-local-dev-webhook
